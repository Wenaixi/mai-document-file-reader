{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "麦麦群文件快速阅读与提炼",
  "description": "智能多格式文档阅读引擎，支持 Word (.docx)、PDF (.pdf)、Excel (.xlsx/.csv)、PPT (.pptx) 及源码纯文本，具备图表 VLM 视觉分析与全格式自适应结构化截断能力。",
  "author": {
    "name": "Wenaixi",
    "url": "https://github.com/Wenaixi/mai-document-file-reader"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/xiexiaojia780/file_reader_plugin"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8"
    },
    {
      "type": "python_package",
      "name": "charset-normalizer",
      "version_spec": ">=3.0"
    },
    {
      "type": "python_package",
      "name": "pypdf",
      "version_spec": ">=4.0.0"
    },
    {
      "type": "python_package",
      "name": "python-docx",
      "version_spec": ">=1.0.0"
    },
    {
      "type": "python_package",
      "name": "openpyxl",
      "version_spec": ">=3.1.0"
    },
    {
      "type": "python_package",
      "name": "python-pptx",
      "version_spec": ">=0.6.21"
    },
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "llm.generate",
    "llm.generate_with_tools",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "wenaixi.mai_document_file_reader"
}